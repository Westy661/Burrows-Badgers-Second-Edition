  <rules>
    <rule name="Armoured by Faith" id="campaign-test-1926-d885-8fde-44e7" hidden="false">
      <description>Two of your models may improve their Fortitude dice by one level, to a maximum of d12. This increases the models’ Levels by one.</description>
    </rule>
    <rule name="Well-funded" id="campaign-test-7aea-9f15-ace0-ac7e" hidden="false">
      <description>You also have an extra 25 Pennies to spend at Band creation, for a total of 375 Pennies.</description>
    </rule>
    <rule name="Allegiance Archetype: Cunning Folk" id="campaign-test-b1ab-a6f3-6bb4-a0e8" hidden="false" />
    <rule name="Magical Archetypes" id="campaign-test-0b10-c900-8ec2-eff6" hidden="false">
      <description>Witch Hunter Magic-users may choose from Light, Noble, and Divine.</description>
    </rule>
    <rule name="Support Quest – Purify" id="campaign-test-456e-c7fe-152f-b2ac" hidden="false">
      <description>Any model that takes an enemy Leader, Second, Magic-user, or enemy with the Uncanny Skill Out of Action gains 1 Fate point and 1 Experience point.</description>
    </rule>
  </rules>

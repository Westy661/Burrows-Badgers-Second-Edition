  <rules>
    <rule name="Born to be Wild" id="campaign-test-0580-000d-9442-925b" hidden="false">
      <description>Three of your models may take either the Strong (1) Skill or the Tough (1) Skill. These are cumulative with any existing Strong/Tough Skills they have due to their Species. This increases the models’ Levels by one.</description>
    </rule>
    <rule name="Stay Pure" id="campaign-test-7ca4-ae17-1cd2-405c" hidden="false">
      <description>No model in a Wildling Band may use any Black Powder weapons.</description>
    </rule>
    <rule name="Allegiance Archetype: All-rounder" id="campaign-test-0f5a-586b-1f9b-2c83" hidden="false">
      <description>Allegiance Archetype: All-rounder</description>
    </rule>
    <rule name="Magical Archetypes" id="campaign-test-c1e7-7c82-6ebb-c9b5" hidden="false">
      <description>Wildling Magic-users may choose from Natural, Wild, Dark, Fate-Weaver, Channelling and Elementalism</description>
    </rule>
    <rule name="Support Quest – Back to Nature" id="campaign-test-8ef3-c799-f2cb-f947" hidden="false">
      <description>Reach Base Contact with the enemy’s Objectives and make an Interact Action to plant them with magically enhanced seeds; any model who seeds an enemy Objective gains 1 Fate point and 1 Experience point. Each Objective can only be seeded once.</description>
    </rule>
  </rules>

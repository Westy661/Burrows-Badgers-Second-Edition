  <sharedRules>
    <rule name="One to Watch" id="campaign-test-08d5-57b4-a046-8b5f" hidden="false">
      <description>Two of your models may improve their Presence or Awareness dice by one level, to a maximum of d12. This increases the models’ Levels by one.</description>
    </rule>
    <rule name="Deep Pockets" id="campaign-test-f05e-a7df-d743-c30d" hidden="false">
      <description>You have an extra 25 Pennies to spend at Band creation, for a total of 375 Pennies.

In addition, in the Post-Battle Phase when checking for Availability of Rare Equipment in the General Store (see page 176), you may roll 3d6, rather than the usual 2d6.</description>
    </rule>
    <rule name="Allegiance Archetype: All-rounder" id="campaign-test-fd1b-123b-073d-4843" hidden="false" />
    <rule name="Magical Archetypes" id="campaign-test-f790-b03c-30c1-169e" hidden="false">
      <description>Freebeast Magic-users may choose from Natural, Dark, Noble, Unbound, Fate-weaver, and Illusionism.</description>
    </rule>
    <rule name="Look After Yourself" id="campaign-test-c66b-8b4b-de4a-ab9e" hidden="false">
      <description>Every model that does not go Out of Action during the Battle gains 1 Experience point, in addition to any normally awarded by the Main Quest being played. Each model still in Action on Turn 3 gains 1 Fate point. Each model still in Action on Turn 6 gains 1 Fate point.</description>
    </rule>
  </sharedRules>
  <categoryEntries>
    <categoryEntry name="Allegiance" id="campaign-test-b6a0-9ed3-91e6-1eab" hidden="false" />
  </categoryEntries>
